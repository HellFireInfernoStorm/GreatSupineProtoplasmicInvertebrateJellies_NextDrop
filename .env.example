# NextDrop configuration. `docker compose up` works without any of this: every value below is the default.
# To change something, copy this file to .env (read automatically by Compose) and edit it.
# Never commit .env or .env.local; only this file is tracked.
#
# Parallel stacks, one per worktree (agent-docs/process/collisions.md): copy this file to .env.local, set a unique
# APP_PORT, then run `docker compose -p wp-<issue> --env-file .env.local up`. The project name keeps containers and
# volumes (and so the database) separate.

# --- Ports -----------------------------------------------------------------------------------------------------
# Host port for the app (API and PWA): http://localhost:8080
APP_PORT=8080

# --- Database --------------------------------------------------------------------------------------------------
# Used by the db container and to build the app's DATABASE_URL. The database is not published to the host.
POSTGRES_USER=nextdrop
POSTGRES_PASSWORD=nextdrop
POSTGRES_DB=nextdrop
# Outside Compose (pnpm dev, prisma), point DATABASE_URL at your own PostgreSQL 16. Compose builds its own.
# DATABASE_URL=postgresql://nextdrop:nextdrop@localhost:5432/nextdrop

# --- Sessions --------------------------------------------------------------------------------------------------
# Signs session cookies and CSRF tokens. At least 32 characters in production.
# Empty: the container generates one on first start and keeps it in the app-data volume.
# Set your own for a public deployment, e.g. `openssl rand -hex 32`.
SESSION_SECRET=
# Days after expiry that a field device (Loader, Driver) may re-authenticate with its PIN.
FIELD_REAUTH_GRACE_DAYS=30
# The public https origin, e.g. https://nextdrop.example.com. An https origin makes the session cookie Secure.
PUBLIC_ORIGIN=

# --- Demo ------------------------------------------------------------------------------------------------------
# Demo clock, reset and presets for judges (spec/data/seed-and-demo.md §15.2).
# It also puts the quick-login chips on the login screens. Those are compiled into the web app when the image is
# built, so after changing this value rebuild: `docker compose up --build`.
DEMO_MODE=true
# Secret for scripted demo calls (x-nextdrop-script-key). Empty disables that path.
DEMO_SCRIPT_KEY=
# Seed reference data, accounts and the story day on every start. Idempotent.
SEED_ON_START=true

# --- Optional services -----------------------------------------------------------------------------------------
# Optimisation sidecar, not built (ADR 0014).
SOLVER_ENABLED=false
SOLVER_URL=
# Domain for the `public` Compose profile (Caddy, automatic HTTPS).
CADDY_DOMAIN=localhost
# Web Push (optional, #65).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# --- Time ----------------------------------------------------------------------------------------------------
# Server time zone. Instants are stored in UTC and displayed in Asia/Colombo.
TZ=Asia/Colombo

# --- Logging ---------------------------------------------------------------------------------------------------
LOG_LEVEL=info
