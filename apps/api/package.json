{
  "name": "@nextdrop/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "seed:pick-fixtures": "tsx prisma/seed/pick-fixtures.ts",
    "test:int": "vitest run --config vitest.integration.config.ts",
    "predev": "prisma generate",
    "pretypecheck": "prisma generate",
    "pretest": "prisma generate",
    "pretest:int": "prisma generate",
    "build": "prisma generate"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@nextdrop/contracts": "workspace:*",
    "@nextdrop/rules": "workspace:*",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "argon2": "^0.45.1",
    "fastify": "^5.12.5",
    "fastify-type-provider-zod": "^7.0.0",
    "pg": "8.23.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nextdrop/config": "workspace:*",
    "@types/node": "^22.19.0",
    "@types/pg": "8.15.6",
    "pino-pretty": "^13.1.3",
    "prisma": "7.10.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  },
  "files": [
    "src",
    "prisma/migrations"
  ]
}
